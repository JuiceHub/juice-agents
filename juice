#!/usr/bin/env bash
# Juice CLI - TypeScript + Ink

set -e

SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
CLI_DIR="$SCRIPT_DIR/frontend/cli"
FRONTEND_DIR="$SCRIPT_DIR/frontend"
DEPENDENCY_CHECK="$FRONTEND_DIR/check-cli-dependencies.mjs"
WORKSPACE_DIR="$(pwd -P)"

export JUICE_WORKSPACE_DIR="$WORKSPACE_DIR"
export PYTHONPATH="$SCRIPT_DIR/sdk/src${PYTHONPATH:+:$PYTHONPATH}"
# 所有前端 workspace 共享唯一的 React 实例。不能在 cli/shared 目录分别安装，
# 否则共享 Hook 会加载另一份 React，导致 Ink 报 Invalid hook call。
if ! node "$DEPENDENCY_CHECK" "$FRONTEND_DIR"; then
    echo "Synchronizing frontend CLI dependencies..."
    (
        cd "$FRONTEND_DIR"
        # 删除旧版独立安装留下的共享依赖；workspace 只允许根级安装。
        rm -rf shared/node_modules cli/node_modules
        npm install --workspace juice-cli
    )
    # 安装完成后再次核验真实包版本与解析位置，避免 npm 缓存留下遮蔽依赖。
    node "$DEPENDENCY_CHECK" "$FRONTEND_DIR"
fi

# Run the TypeScript + Ink CLI
cd "$CLI_DIR"
exec npm run start -- "$@"
